    {
      "title": "Function.Semiconj.comp_left",
      "name": "Function.Semiconj.comp_left",
      "kind": "theorem",
      "module": "Mathlib.Logic.Function.Conjugate",
      "line": 65,
      "statement": "theorem comp_left (hbc : Semiconj fbc gb gc) (hab : Semiconj fab ga gb) :\r\n    Semiconj (fbc ∘ fab) ga gc",
      "doc_comment": "If `fbc : β → γ` semiconjugates `gb` to `gc` and `fab : α → β` semiconjugates `ga` to `gb`,\nthen `fbc ∘ fab` semiconjugates `ga` to `gc`.\n\nSee also `Function.Semiconj.trans` for a version with reversed arguments.\n\n**Backward compatibility note:** before 2024-01-13,\nthis lemma used to have the same order of arguments that `Function.Semiconj.trans` has now.",
      "source_sha256": "e5e3aa3e4f3fcbcf97d7c7b33e1be84a1333608f483d30cdcc423a09dfe7bc98",
      "extraction": "textual_unverified",
      "proof_status": "not_checked",
      "id": "snapshot:Function.Semiconj.comp_left",
      "file": "snapshot:Mathlib.Logic.Function.Conjugate",
