      "kind": "lemma",
      "module": "Mathlib.Logic.Function.Conjugate",
      "line": 84,
      "statement": "lemma inverse_left {f' : β → α} (h : Semiconj f ga gb)\r\n    (hf₁ : LeftInverse f' f) (hf₂ : RightInverse f' f) : Semiconj f' gb ga",
