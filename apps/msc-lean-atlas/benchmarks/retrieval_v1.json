    {
      "title": "Function.Semiconj.inverses_right",
      "name": "Function.Semiconj.inverses_right",
      "kind": "theorem",
      "module": "Mathlib.Logic.Function.Conjugate",
      "line": 78,
      "statement": "theorem inverses_right (h : Semiconj f ga gb) (ha : RightInverse ga' ga) (hb : LeftInverse gb' gb) :\r\n    Semiconj f ga' gb'",
      "doc_comment": "If `f : α → β` semiconjugates `ga : α → α` to `gb : β → β`,\n`ga'` is a right inverse of `ga`, and `gb'` is a left inverse of `gb`,\nthen `f` semiconjugates `ga'` to `gb'` as well.",
      "source_sha256": "e5e3aa3e4f3fcbcf97d7c7b33e1be84a1333608f483d30cdcc423a09dfe7bc98",
      "extraction": "textual_unverified",
